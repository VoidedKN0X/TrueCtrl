    <!-- Notifications -->
    <string name="group_notifications">Notifications</string>
    <string name="notifications">Notifications</string>
    <string name="notifications_subtitle">Background checks, push from TrueNAS, what to notify about</string>
    <string name="notif_intro">TrueCtrl can check your TrueNAS in the background and tell you when something needs attention. Push through your own ntfy adds instant notifications for every TrueNAS alert. Neither uses Google services.</string>
    <string name="notif_permission_off">Notifications are turned off for TrueCtrl.</string>
    <string name="notif_permission_allow">Allow notifications</string>
    <string name="group_polling">Background checks</string>
    <string name="polling_title">Check in the background</string>
    <string name="polling_subtitle">Looks at every saved server and notifies about new problems</string>
    <string name="polling_interval">Check every</string>
    <plurals name="polling_interval_value">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <string name="polling_footer">Android runs background checks at most every 15 minutes, and can delay them to save battery. Each check opens its own short, read-only connection. Server unreachable and pool usage above your warning level can only come from these checks, so keep them on even with push.</string>
