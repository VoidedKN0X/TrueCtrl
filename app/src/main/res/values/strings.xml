    <string name="auth_method">Sign in with</string>
    <string name="auth_api_key">API key</string>
    <string name="auth_password">Password</string>
    <string name="auth_api_key_note">Recommended. Create the key under Credentials › Users for a user with only the roles TrueCtrl needs; see the README.</string>
    <string name="auth_password_note">Signs in with your TrueNAS login. Two-factor codes are supported, but then you\'ll need a new code each time TrueCtrl reconnects, so an API key is easier.</string>
