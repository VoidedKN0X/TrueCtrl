    <!-- Certificate -->
    <string name="cert_title">Trust this certificate?</string>
    <string name="cert_changed_title">Certificate changed</string>
    <string name="cert_intro">%1$s uses a certificate your phone doesn\'t know, like the self-signed certificate TrueNAS creates on install.</string>
    <string name="cert_changed_warning">%1$s now presents a different certificate from the one you trusted. Only continue if you replaced or renewed it yourself.</string>
    <string name="cert_check">Check that this SHA-256 fingerprint matches your TrueNAS certificate (open TrueNAS in a browser and view the certificate, or run in the TrueNAS shell: openssl x509 -noout -fingerprint -sha256 -in /etc/certificates/truenas_default.crt):</string>
